# Copy this file to .env.local and adjust the values.
# Only variables starting with VITE_ are exposed to the frontend.
# Never put passwords, tokens or other secrets in these files.

# Base URL of the future Spring Boot REST API (no trailing slash).
# Example: https://api.42xacademy.com/api
VITE_API_BASE_URL=

# true  = use the built-in mock data (no backend needed)
# false = call the Spring Boot API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
